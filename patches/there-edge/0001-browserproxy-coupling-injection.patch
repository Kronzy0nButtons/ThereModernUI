 };
 
-console.log('There Edge compatibility coupling installed');
\ No newline at end of file
+console.log('There Edge compatibility coupling installed');
+
+// ------------------------------------------------------------------
+// ThereModernUI: grab the name + Product ID from an item About page and put
+// them in the page title. The dock reads the title back through
+// /client/windows/<id>/titleBarText. We're running inside the About page
+// itself, so there's no CORS or login problem reading it.
+// ------------------------------------------------------------------
+(function() {
+  function harvestAbout() {
+    try {
+      const title = document.title || '';
+      const tm = title.match(/There Help: About (.+)$/i);
+      if (!tm) {
+        return; // not an item About page
+      }
+      const name = tm[1].trim();
+
+      const text = document.body ? (document.body.innerText || '') : '';
+      const pm = text.match(/Product\s*ID[:\s]*?(\d{4,10})/i);
+      if (!pm) {
+        return; // no product id (avatar/brick/doc about page)
+      }
+      const productId = pm[1];
+
+      // the photo is on the page as /catalog/media/<file>, take the filename
+      // so the dock doesn't need the (CORS blocked) catalog XML
+      let image = '';
+      const imgs = document.getElementsByTagName('img');
+      for (let k = 0; k < imgs.length; k++) {
+        const src = imgs[k].getAttribute('src') || '';
+        // any filename chars: some have brackets, hyphens or %20 in them
+        const im = src.match(/catalog\/media\/([^"'?#\s│]+\.(?:jpg|jpeg|gif|png))/i);
+        if (im) { image = im[1]; break; }
+      }
+
+      const um = (location.search || '').match(/poid=(\d+)/i);
+      const poid = um ? um[1] : '';
+
+      // title format the dock looks for:
+      //   TMUI<sep>productId<sep>poid<sep>image<sep>name   (sep = U+2502)
+      const S = '\u2502';
+      document.title = 'TMUI' + S + productId + S + poid + S + image + S + name;
+    } catch (e) {
+    }
+  }
+
+  if (document.readyState === 'complete') {
+    harvestAbout();
+  } else {
+    window.addEventListener('load', harvestAbout);
+  }
+})();
