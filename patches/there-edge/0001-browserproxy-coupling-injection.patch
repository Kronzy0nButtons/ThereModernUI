+// bits below are hmphus's and unchanged.
+
 if (window.VoiceTrainer != undefined) {
   VoiceTrainer.style.display = 'none';
   VoiceTrainer.configState = 0;
@@ -68,4 +77,56 @@ ActiveXObject.prototype.load = function(url) {
