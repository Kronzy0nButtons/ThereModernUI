+// ThereModernUI (DANKIES): chat feed relay.
+// The client's chat feed doesn't serve two readers independently: new lines go
+// to whichever request it answers next, so when the dock read it too, the
+// Command Bar missed lines and /commands typed in chat went unanswered. Now when
+// any other page reads the feed, we copy its answer and hand it to the dock as
+// "tmui_chatfeed" = "<0 backlog | 1 new>|<xml>", and the dock stops reading.
+static CComAutoCriticalSection g_tmuiRelayLock;
+static ATL::CSimpleArray<CStringW> g_tmuiRelayQueue;
+static volatile LONG g_tmuiReaderSeen = 0;
+static LONG g_tmuiReaderSeq = 0;
+
+// the other page just asked the feed: tell the dock straight away (before any
+// answer) so it never starts reading the feed itself
+void TmuiRelayReaderSeen()
+{
+    InterlockedExchange(&g_tmuiReaderSeen, 1);
+}
+
+// pages that have read the feed for the dock: when one closes, the dock
+// takes the feed back at once
+static ATL::CSimpleArray<void *> g_tmuiReaders;
+static volatile LONG g_tmuiReaderGone = 0;
+
+void TmuiRelayNoteReader(void *owner)
+{
+    g_tmuiRelayLock.Lock();
+    if (g_tmuiReaders.Find(owner) < 0)
+        g_tmuiReaders.Add(owner);
+    g_tmuiRelayLock.Unlock();
+}
+
+void TmuiRelayReaderGone(void *owner)
+{
+    g_tmuiRelayLock.Lock();
+    bool was = g_tmuiReaders.Remove(owner) != FALSE;
+    g_tmuiRelayLock.Unlock();
+    if (was)
+        InterlockedExchange(&g_tmuiReaderGone, 1);
+}
+
+// a feed request from a page that isn't one of ours, while the dock is listening
+bool TmuiRelayWanted(void *owner)
+{
+    bool wanted = g_tmuiSubscribers.GetSize() > 0 &&
+        g_tmuiSubscribers.Find(static_cast<FlashProxyModule *>(owner)) < 0;
+    if (wanted)
+        TmuiRelayNoteReader(owner);
+    return wanted;
+}
+
+// any thread: queue it, TmuiRelayDeliver sends it from the UI thread
+void TmuiRelayQueue(const char *data, int len, bool backlog)
+{
+    if (len <= 0 || len > 512 * 1024)
+        return;
+    int wlen = MultiByteToWideChar(CP_UTF8, 0, data, len, nullptr, 0);
+    if (wlen <= 0)
+        return;
+    CStringW value(backlog ? L"0|" : L"1|");
+    CStringW xml;
+    MultiByteToWideChar(CP_UTF8, 0, data, len, xml.GetBuffer(wlen), wlen);
+    xml.ReleaseBuffer(wlen);
+    value += xml;
+    g_tmuiRelayLock.Lock();
+    g_tmuiRelayQueue.Add(value);
+    g_tmuiRelayLock.Unlock();
+}
