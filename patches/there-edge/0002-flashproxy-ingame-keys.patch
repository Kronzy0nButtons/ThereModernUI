+// ThereModernUI: "rects=x,y,w,h;x,y,w,h;..." = the parts of the window the page
+// is really using (window coordinates). The real OS window then shrinks to just
+// those parts, so clicks anywhere else land in the game, while the client keeps
+// believing the window is its full constant size and never re-anchors it.
+// "rects=all" turns it off again, an empty list means nothing is in use.
+void FlashProxyModule::TmuiApplyShape(const WCHAR *query)
+{
+    CComBSTR bvalue = _wcsnicmp(query, L"rects=", 6) == 0 ? query + 6 : L"";
+    if (FAILED(UrlUnescapeInPlace(bvalue, 0)))
+        return;
+
+    if (_wcsicmp(bvalue, L"all") == 0)
+    {
+        m_tmuiShapeOn = false;
+        m_tmuiShapeCount = 0;
+        TmuiPlaceWindow();
+        return;
+    }
+
+    RECT box = {0, 0, 0, 0};
+    bool first = true;
+    m_tmuiShapeCount = 0;
+
+    WCHAR *text = bvalue;
+    while (text != nullptr && text[0] != 0)
+    {
+        LONG x = wcstol(text, &text, 10);
+        if (text[0] != ',')
+            break;
+        LONG y = wcstol(text + 1, &text, 10);
+        if (text[0] != ',')
+            break;
+        LONG w = wcstol(text + 1, &text, 10);
+        if (text[0] != ',')
+            break;
+        LONG h = wcstol(text + 1, &text, 10);
+
+        if (w > 0 && h > 0)
+        {
+            if (m_tmuiShapeCount < _countof(m_tmuiShapeRects))
+            {
+                RECT &r = m_tmuiShapeRects[m_tmuiShapeCount++];
+                r.left = x;
+                r.top = y;
+                r.right = x + w;
+                r.bottom = y + h;
+            }
+            if (first)
+            {
+                box.left = x;
+                box.top = y;
+                box.right = x + w;
+                box.bottom = y + h;
+                first = false;
+            }
+            else
+            {
+                box.left = min(box.left, x);
+                box.top = min(box.top, y);
+                box.right = max(box.right, x + w);
+                box.bottom = max(box.bottom, y + h);
+            }
+        }
+
+        if (text[0] != ';')
+            break;
+        ++text;
+    }
+
+    m_tmuiShapeOn = true;
+    m_tmuiShapeBox = box;
+    TmuiPlaceWindow();
+}
+
+// Put the real OS window where it belongs: normally the client's full rect, in
+// shape mode just the used part of it. The WebView's bounds get a negative
+// offset so the page doesn't notice the window moved underneath it.
+void FlashProxyModule::TmuiPlaceWindow()
+{
+    if (m_proxyWnd == nullptr)
+        return;
+
+    LONG pageW = max(1, m_size.cx);
+    LONG pageH = max(1, m_size.cy);
+    LONG x = m_pos.cx;
+    LONG y = m_pos.cy;
+    LONG w = pageW;
+    LONG h = pageH;
+
+    if (m_tmuiShapeOn)
+    {
+        RECT box = m_tmuiShapeBox;
+        box.left = max(0L, box.left);
+        box.top = max(0L, box.top);
+        box.right = min((LONG)pageW, box.right);
+        box.bottom = min((LONG)pageH, box.bottom);
+        if (box.right <= box.left || box.bottom <= box.top)
+        {
+            // nothing in use: keep a 1px sliver so the window still exists
+            box.left = 0;
+            box.top = 0;
+            box.right = 1;
+            box.bottom = 1;
+        }
+        x = m_pos.cx + box.left;
+        y = m_pos.cy + box.top;
+        w = box.right - box.left;
+        h = box.bottom - box.top;
+    }
+
+    SetWindowPos(m_proxyWnd, nullptr, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE);
+
+    if (m_controller != nullptr)
+    {
+        RECT bounds;
+        bounds.left = -(x - m_pos.cx);
+        bounds.top = -(y - m_pos.cy);
+        bounds.right = bounds.left + pageW;
+        bounds.bottom = bounds.top + pageH;
+        m_controller->put_Bounds(bounds);
+        m_controller->NotifyParentWindowPositionChanged();
+    }
+}
