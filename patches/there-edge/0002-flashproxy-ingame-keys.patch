+// ThereModernUI: the chat feed answer minus every <msg> whose text starts
+// with "/". the reader page never sees a /command, so it can't run it too
+CStringA FlashRequestProxy::TmuiStripCommands(const CStringA &xml)
+{
+    CStringA out;
+    int pos = 0;
+    const int len = xml.GetLength();
+    for (;;)
+    {
+        int start = xml.Find("<msg", pos);
+        if (start < 0 || start + 4 >= len)
+        {
+            out += xml.Mid(pos);
+            break;
+        }
+        char next = xml[start + 4];
+        if (next != '>' && next != ' ')
+        {
+            out += xml.Mid(pos, start + 4 - pos);
+            pos = start + 4;
+            continue;
+        }
+        int end = xml.Find("</msg>", start);
+        if (end < 0)
+        {
+            out += xml.Mid(pos);
+            break;
+        }
+        end += 6;
+        bool command = false;
+        int text = xml.Find("<text>", start);
+        if (text >= 0 && text < end)
+        {
+            int k = text + 6;
+            if (xml.Mid(k, 9) == "<![CDATA[")
+                k += 9;
+            while (k < end && (xml[k] == ' ' || xml[k] == '\t' || xml[k] == '\r' || xml[k] == '\n'))
+                ++k;
+            command = k < end && xml[k] == '/';
+        }
+        out += xml.Mid(pos, start - pos);
+        if (!command)
+            out += xml.Mid(start, end - start);
+        pos = end;
+    }
+    return out;
+}
+
+// ThereModernUI: hand the copied chat feed answer over (once). Read can run off
+// the UI thread, so this only queues it; FlashProxy's UI timer delivers it.
+void FlashRequestProxy::TeeFlush()
+{
+    if (!m_tee || m_teeSent || m_teeBuf.GetLength() == 0)
+        return;
+    m_teeSent = true;
+    TmuiRelayQueue(m_teeBuf.GetString(), m_teeBuf.GetLength(), m_teeBacklog);
+}
