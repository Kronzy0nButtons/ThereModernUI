+// ThereModernUI: webapps bridge. Each request becomes a job: a worker thread
+// pulls the bytes with WinInet while the page waits on the deferral, and the
+// UI timer hands the finished answer back on the right thread.
+struct TmuiWebJob
+{
+    CComPtr<ICoreWebView2WebResourceRequestedEventArgs> args;
+    CComPtr<ICoreWebView2Deferral> deferral;
+    CComPtr<ICoreWebView2Environment> env;
+    CStringW path;
+    CStringA data;
+    CStringW file;     // file lane: the disk file to answer with (webapps lane: empty)
+    CStringW ctype;    // content type of the answer
+    HWND wnd;          // proxy window of the asking module: delivery is posted
+                       // here, so it works before any page starts the timer
+    volatile LONG done;
+    bool ok;
+};
+
+static CComAutoCriticalSection g_tmuiWebLock;
+static ATL::CSimpleArray<TmuiWebJob*> g_tmuiWebJobs;
+
+static DWORD WINAPI TmuiWebThread(LPVOID param)
+{
+    TmuiWebJob *job = static_cast<TmuiWebJob*>(param);
+    HINTERNET session = InternetOpen(L"ThereModernUI", INTERNET_OPEN_TYPE_PRECONFIG, nullptr, nullptr, 0);
+    if (session != nullptr)
+    {
+        HINTERNET connection = InternetConnect(session, L"webapps.prod.there.com", INTERNET_DEFAULT_HTTPS_PORT,
+                                               nullptr, nullptr, INTERNET_SERVICE_HTTP, 0, 0);
+        if (connection != nullptr)
+        {
+            HINTERNET request = HttpOpenRequest(connection, L"GET", job->path, nullptr, nullptr, nullptr,
+                                                INTERNET_FLAG_SECURE | INTERNET_FLAG_NO_CACHE_WRITE |
+                                                INTERNET_FLAG_RELOAD | INTERNET_FLAG_NO_COOKIES, 0);
+            if (request != nullptr)
+            {
+                if (HttpSendRequest(request, nullptr, 0, nullptr, 0))
+                {
+                    char buffer[16384];
+                    DWORD got = 0;
+                    while (InternetReadFile(request, buffer, sizeof(buffer), &got) && got > 0)
+                    {
+                        job->data.Append(buffer, got);
+                        if (job->data.GetLength() > 4 * 1024 * 1024)
+                            break;
+                    }
+                    job->ok = job->data.GetLength() > 0;
+                }
+                InternetCloseHandle(request);
+            }
+            InternetCloseHandle(connection);
+        }
+        InternetCloseHandle(session);
+    }
+    // read the window first: once done is set the UI thread may free the job
+    HWND wnd = job->wnd;
+    InterlockedExchange(&job->done, 1);
+    if (wnd != nullptr)
+        PostMessage(wnd, WM_TMUI_WEB_DELIVER, 0, 0);
+    return 0;
+}
+
+// ThereModernUI: the file lane. The stock path binds every file a control
+// requests through URLMon on the client's UI thread, and a Windows 11 update
+// made that bind stall for ~8 seconds per request, freezing the 3D world
+// while a control loads (the rubberbanding in There's changelog). Static
+// control files are plain files on disk next to the client, so one worker
+// thread reads them directly instead: off the UI thread a stall cannot touch
+// the simulation, and a disk read does not go near the component that stalls.
+static ATL::CSimpleArray<TmuiWebJob*> g_tmuiFileQueue;
+static HANDLE g_tmuiFileEvent = nullptr;
+static HANDLE g_tmuiFileThread = nullptr;
+static WCHAR g_tmuiFileBase[MAX_PATH] = {0};
+
+static const WCHAR *TmuiFileType(const WCHAR *ext)
+{
+    static const struct { const WCHAR *ext; const WCHAR *type; } types[] =
+    {
+        {L"html",  L"text/html"},
+        {L"css",   L"text/css"},
+        {L"js",    L"application/javascript"},
+        {L"png",   L"image/png"},
+        {L"jpg",   L"image/jpeg"},
+        {L"jpeg",  L"image/jpeg"},
+        {L"gif",   L"image/gif"},
+        {L"svg",   L"image/svg+xml"},
+        {L"ico",   L"image/x-icon"},
+        {L"swf",   L"application/vnd.adobe.flash.movie"},
+        {L"wasm",  L"application/wasm"},
+        {L"woff",  L"font/woff"},
+        {L"woff2", L"font/woff2"},
+        {L"ttf",   L"font/ttf"},
+        {L"otf",   L"font/otf"},
+        {L"mp3",   L"audio/mpeg"},
+        {L"wav",   L"audio/wav"},
+        {L"ogg",   L"audio/ogg"},
+    };
+    for (int i = 0; i < _countof(types); ++i)
+    {
+        if (_wcsicmp(ext, types[i].ext) == 0)
+            return types[i].type;
+    }
+    return nullptr;
+}
+
+static DWORD WINAPI TmuiFileThread(LPVOID)
+{
+    for (;;)
+    {
+        WaitForSingleObject(g_tmuiFileEvent, INFINITE);
+        for (;;)
+        {
+            TmuiWebJob *job = nullptr;
+            g_tmuiWebLock.Lock();
+            if (g_tmuiFileQueue.GetSize() > 0)
+            {
+                job = g_tmuiFileQueue[0];
+                g_tmuiFileQueue.RemoveAt(0);
+            }
+            g_tmuiWebLock.Unlock();
+            if (job == nullptr)
+                break;
+
+            // two attempts: the file can be mid-copy while the mod updates
+            for (int attempt = 0; attempt < 2 && !job->ok; ++attempt)
+            {
+                HANDLE file = CreateFile(job->file, GENERIC_READ,
+                                         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                         nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+                if (file == INVALID_HANDLE_VALUE)
+                    continue;
+
+                LARGE_INTEGER size = {};
+                if (GetFileSizeEx(file, &size) && size.QuadPart >= 0 && size.QuadPart <= 64 * 1024 * 1024)
+                {
+                    DWORD want = static_cast<DWORD>(size.QuadPart);
+                    char *buffer = job->data.GetBuffer(static_cast<int>(want));
+                    DWORD total = 0;
+                    while (total < want)
+                    {
+                        DWORD got = 0;
+                        if (!ReadFile(file, buffer + total, want - total, &got, nullptr) || got == 0)
+                            break;
+                        total += got;
+                    }
+                    job->data.ReleaseBufferSetLength(static_cast<int>(total));
+                    job->ok = total == want;
+                }
+                CloseHandle(file);
+            }
+            // read the window first: once done is set the UI thread may free
+            // the job
+            HWND wnd = job->wnd;
+            InterlockedExchange(&job->done, 1);
+            if (wnd != nullptr)
+                PostMessage(wnd, WM_TMUI_WEB_DELIVER, 0, 0);
+        }
+    }
+    return 0;
+}
+
+HRESULT FlashProxyModule::TmuiWebFetch(ICoreWebView2WebResourceRequestedEventArgs *args, const WCHAR *rest)
+{
+    CComPtr<ICoreWebView2Deferral> deferral;
+    if (FAILED(args->GetDeferral(&deferral)) || deferral == nullptr)
+        return E_FAIL;
+
+    TmuiWebJob *job = new TmuiWebJob();
+    job->args = args;
+    job->deferral = deferral;
+    job->env = m_environment;
+    job->path = L"/";
+    job->path += rest;
+    job->ctype = L"text/xml";
+    job->wnd = m_proxyWnd;
+    job->done = 0;
+    job->ok = false;
+
+    g_tmuiWebLock.Lock();
+    g_tmuiWebJobs.Add(job);
+    g_tmuiWebLock.Unlock();
+
+    HANDLE thread = CreateThread(nullptr, 0, TmuiWebThread, job, 0, nullptr);
+    if (thread == nullptr)
+        InterlockedExchange(&job->done, 1);
+    else
+        CloseHandle(thread);
+    return S_OK;
+}
+
+HRESULT FlashProxyModule::TmuiFileFetch(ICoreWebView2WebResourceRequestedEventArgs *args, const WCHAR *path)
+{
+    // kill switch: TMUI_FILELANE=0 puts every request back on the stock bind
+    static LONG enabled = -1;
+    if (enabled < 0)
+    {
+        WCHAR value[8] = {0};
+        GetEnvironmentVariable(L"TMUI_FILELANE", value, _countof(value));
+        enabled = wcscmp(value, L"0") == 0 ? 0 : 1;
+    }
+    // no proxy window means no posted delivery: leave it to the stock bind
+    if (enabled == 0 || m_proxyWnd == nullptr || !IsWindow(m_proxyWnd))
+        return S_FALSE;
+
+    if (path == nullptr || path[0] != L'/' || wcsstr(path, L"..") != nullptr)
+        return S_FALSE;
+
+    CStringW rel(path + 1);
+    int cut = rel.FindOneOf(L"?#");
+    if (cut >= 0)
+        rel = rel.Left(cut);
+
+    int dot = rel.ReverseFind(L'.');
+    const WCHAR *type = dot >= 0 ? TmuiFileType(rel.GetString() + dot + 1) : nullptr;
+    if (type == nullptr)
+        return S_FALSE;
+
+    // control files resolve against the client's working directory (the
+    // movie probe in put_Movie leans on the same fact); pin that root once
+    if (g_tmuiFileBase[0] == 0 && GetCurrentDirectory(_countof(g_tmuiFileBase), g_tmuiFileBase) == 0)
+        return S_FALSE;
+
+    rel.Replace(L'/', L'\\');
+    CStringW full(g_tmuiFileBase);
+    full += L'\\';
+    full += rel;
+
+    DWORD attributes = GetFileAttributes(full);
+    if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0)
+        return S_FALSE;    // not a plain file here, the stock bind knows better
+
+    g_tmuiWebLock.Lock();
+    if (g_tmuiFileEvent == nullptr)
+        g_tmuiFileEvent = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+    if (g_tmuiFileThread == nullptr && g_tmuiFileEvent != nullptr)
+        g_tmuiFileThread = CreateThread(nullptr, 0, TmuiFileThread, nullptr, 0, nullptr);
+    bool ready = g_tmuiFileThread != nullptr;
+    g_tmuiWebLock.Unlock();
+    if (!ready)
+        return S_FALSE;
+
+    CComPtr<ICoreWebView2Deferral> deferral;
+    if (FAILED(args->GetDeferral(&deferral)) || deferral == nullptr)
+        return S_FALSE;
+
+    TmuiWebJob *job = new TmuiWebJob();
+    job->args = args;
+    job->deferral = deferral;
+    job->env = m_environment;
+    job->file = full;
+    job->ctype = type;
+    job->wnd = m_proxyWnd;
+    job->done = 0;
+    job->ok = false;
+
+    g_tmuiWebLock.Lock();
+    g_tmuiWebJobs.Add(job);
+    g_tmuiFileQueue.Add(job);
+    g_tmuiWebLock.Unlock();
+    SetEvent(g_tmuiFileEvent);
+    return S_OK;
+}
+
+// ThereModernUI: the picture store. Catalog photos (wardrobe, inventory) are
+// kept on disk under %LOCALAPPDATA%\There\TmuiImages and served from there,
+// so each one is downloaded once, ever, instead of every time the browser
+// cache forgets it. A small pool of workers fetches the missing ones from
+// webapps.prod.there.com: the dock's live requests jump the queue, and the
+// dock hands over its whole item list after login (tmuiPrefetch) so the
+// photos are usually on disk before the panel even opens.
+static ATL::CSimpleArray<TmuiWebJob*> g_tmuiImgQueue;
+static HANDLE g_tmuiImgSem = nullptr;
+static bool g_tmuiImgStarted = false;
+static WCHAR g_tmuiImgDir[MAX_PATH] = {0};
+
+static bool TmuiImgName(const WCHAR *name)
+{
+    size_t len = name != nullptr ? wcslen(name) : 0;
+    if (len < 5 || len > 120 || wcsstr(name, L"..") != nullptr)
+        return false;
+    for (size_t i = 0; i < len; ++i)
+    {
+        WCHAR c = name[i];
+        if (!((c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z') || (c >= L'0' && c <= L'9') ||
+              c == L'.' || c == L'_' || c == L'-'))
+            return false;
+    }
+    const WCHAR *ext = wcsrchr(name, L'.');
+    return ext != nullptr && (_wcsicmp(ext, L".gif") == 0 || _wcsicmp(ext, L".jpg") == 0 ||
+                              _wcsicmp(ext, L".jpeg") == 0 || _wcsicmp(ext, L".png") == 0);
+}
+
+static bool TmuiImgDirReady()
+{
+    if (g_tmuiImgDir[0] != 0)
+        return true;
+    WCHAR dir[MAX_PATH] = {0};
+    if (FAILED(SHGetFolderPath(nullptr, CSIDL_LOCAL_APPDATA, nullptr, SHGFP_TYPE_CURRENT, dir)) || dir[0] == 0)
+        return false;
+    if (!PathAppend(dir, L"There"))
+        return false;
+    CreateDirectory(dir, nullptr);
+    if (!PathAppend(dir, L"TmuiImages"))
+        return false;
+    CreateDirectory(dir, nullptr);
+    if (GetFileAttributes(dir) == INVALID_FILE_ATTRIBUTES)
+        return false;
+    wcscpy_s(g_tmuiImgDir, dir);
+    return true;
+}
+
+static bool TmuiReadWhole(const WCHAR *path, CStringA &out)
+{
+    HANDLE file = CreateFile(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+        return false;
+    bool ok = false;
+    LARGE_INTEGER size = {};
+    if (GetFileSizeEx(file, &size) && size.QuadPart > 0 && size.QuadPart <= 8 * 1024 * 1024)
+    {
+        DWORD want = static_cast<DWORD>(size.QuadPart);
+        char *buffer = out.GetBuffer(static_cast<int>(want));
+        DWORD total = 0;
+        while (total < want)
+        {
+            DWORD got = 0;
+            if (!ReadFile(file, buffer + total, want - total, &got, nullptr) || got == 0)
+                break;
+            total += got;
+        }
+        out.ReleaseBufferSetLength(static_cast<int>(total));
+        ok = total == want;
+    }
+    CloseHandle(file);
+    return ok;
+}
+
+static DWORD WINAPI TmuiImgThread(LPVOID)
+{
+    // one session per worker: the connection to the image host is reused
+    HINTERNET session = InternetOpen(L"ThereModernUI", INTERNET_OPEN_TYPE_PRECONFIG, nullptr, nullptr, 0);
+    HINTERNET connection = session != nullptr ?
+        InternetConnect(session, L"webapps.prod.there.com", INTERNET_DEFAULT_HTTPS_PORT,
+                        nullptr, nullptr, INTERNET_SERVICE_HTTP, 0, 0) : nullptr;
+    for (;;)
+    {
+        WaitForSingleObject(g_tmuiImgSem, INFINITE);
+        TmuiWebJob *job = nullptr;
+        g_tmuiWebLock.Lock();
+        if (g_tmuiImgQueue.GetSize() > 0)
+        {
+            job = g_tmuiImgQueue[0];
+            g_tmuiImgQueue.RemoveAt(0);
+        }
+        g_tmuiWebLock.Unlock();
+        if (job == nullptr)
+            continue;
+
+        bool have = TmuiReadWhole(job->file, job->data);
+        if (!have && connection != nullptr)
+        {
+            CStringW path(L"/catalog/media/");
+            path += job->path;
+            HINTERNET request = HttpOpenRequest(connection, L"GET", path, nullptr, nullptr, nullptr,
+                                                INTERNET_FLAG_SECURE | INTERNET_FLAG_NO_COOKIES |
+                                                INTERNET_FLAG_KEEP_CONNECTION | INTERNET_FLAG_NO_CACHE_WRITE, 0);
+            if (request != nullptr)
+            {
+                DWORD status = 0;
+                DWORD statusLen = sizeof(status);
+                if (HttpSendRequest(request, nullptr, 0, nullptr, 0) &&
+                    HttpQueryInfo(request, HTTP_QUERY_STATUS_CODE | HTTP_QUERY_FLAG_NUMBER, &status, &statusLen, nullptr) &&
+                    status == 200)
+                {
+                    CStringA body;
+                    char buffer[16384];
+                    DWORD got = 0;
+                    while (InternetReadFile(request, buffer, sizeof(buffer), &got) && got > 0)
+                    {
+                        body.Append(buffer, got);
+                        if (body.GetLength() > 8 * 1024 * 1024)
+                            break;
+                    }
+                    if (body.GetLength() > 0 && body.GetLength() <= 8 * 1024 * 1024)
+                    {
+                        // write beside it, then swap in: a half-written file
+                        // is never served
+                        WCHAR part[MAX_PATH + 32];
+                        _snwprintf_s(part, _countof(part), _TRUNCATE, L"%s.%lu.part",
+                                     job->file.GetString(), GetCurrentThreadId());
+                        HANDLE file = CreateFile(part, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                                                 FILE_ATTRIBUTE_NORMAL, nullptr);
+                        if (file != INVALID_HANDLE_VALUE)
+                        {
+                            DWORD wrote = 0;
+                            BOOL written = WriteFile(file, body.GetString(), body.GetLength(), &wrote, nullptr);
+                            CloseHandle(file);
+                            if (written && wrote == static_cast<DWORD>(body.GetLength()))
+                                MoveFileEx(part, job->file, MOVEFILE_REPLACE_EXISTING);
+                            else
+                                DeleteFile(part);
+                        }
+                        job->data = body;
+                        have = true;
+                    }
+                }
+                InternetCloseHandle(request);
+            }
+        }
+
+        if (job->args == nullptr)
+        {
+            // a prefetch: nobody is waiting on it
+            delete job;
+            continue;
+        }
+        job->ok = have;
+        HWND wnd = job->wnd;
+        InterlockedExchange(&job->done, 1);
+        if (wnd != nullptr)
+            PostMessage(wnd, WM_TMUI_WEB_DELIVER, 0, 0);
+    }
+    return 0;
+}
+
+static bool TmuiImgStart()
+{
+    if (!TmuiImgDirReady())
+        return false;
+    g_tmuiWebLock.Lock();
+    if (!g_tmuiImgStarted)
+    {
+        g_tmuiImgSem = CreateSemaphore(nullptr, 0, 0x7FFFFFFF, nullptr);
+        if (g_tmuiImgSem != nullptr)
+        {
+            for (int i = 0; i < 4; ++i)
+            {
+                HANDLE thread = CreateThread(nullptr, 0, TmuiImgThread, nullptr, 0, nullptr);
+                if (thread != nullptr)
+                    CloseHandle(thread);
+            }
+            g_tmuiImgStarted = true;
+        }
+    }
+    bool ready = g_tmuiImgStarted;
+    g_tmuiWebLock.Unlock();
+    return ready;
+}
+
+static TmuiWebJob *TmuiImgJob(const WCHAR *name)
+{
+    TmuiWebJob *job = new TmuiWebJob();
+    job->path = name;
+    job->file = g_tmuiImgDir;
+    job->file += L'\\';
+    job->file += name;
+    const WCHAR *ext = wcsrchr(name, L'.');
+    const WCHAR *type = TmuiFileType(ext != nullptr ? ext + 1 : L"");
+    job->ctype = type != nullptr ? type : L"application/octet-stream";
+    job->wnd = nullptr;
+    job->done = 0;
+    job->ok = false;
+    return job;
+}
+
+// /tmui-img/<name>: on disk = the file lane (instant), else a worker fetches
+// and keeps it, this request first in line
+HRESULT FlashProxyModule::TmuiImgFetch(ICoreWebView2WebResourceRequestedEventArgs *args, const WCHAR *name)
+{
+    if (!TmuiImgName(name) || m_proxyWnd == nullptr || !TmuiImgStart())
+    {
+        CComPtr<ICoreWebView2WebResourceResponse> response;
+        if (SUCCEEDED(m_environment->CreateWebResourceResponse(nullptr, 404, L"Not Found", L"", &response)) &&
+            response != nullptr)
+            args->put_Response(response);
+        return S_OK;
+    }
+
+    CComPtr<ICoreWebView2Deferral> deferral;
+    if (FAILED(args->GetDeferral(&deferral)) || deferral == nullptr)
+        return E_FAIL;
+
+    TmuiWebJob *job = TmuiImgJob(name);
+    job->args = args;
+    job->deferral = deferral;
+    job->env = m_environment;
+    job->wnd = m_proxyWnd;
+
+    // the file lane's reader may not be up yet: the image workers read the
+    // disk too, so they take it then
+    bool onDisk = GetFileAttributes(job->file) != INVALID_FILE_ATTRIBUTES;
+    g_tmuiWebLock.Lock();
+    bool lane = onDisk && g_tmuiFileThread != nullptr && g_tmuiFileEvent != nullptr;
+    g_tmuiWebJobs.Add(job);
+    if (lane)
+    {
+        g_tmuiFileQueue.Add(job);
+    }
+    else
+    {
+        // live requests go ahead of any prefetch backlog
+        g_tmuiImgQueue.Add(job);
+        for (int i = g_tmuiImgQueue.GetSize() - 1; i > 0; --i)
+        {
+            if (g_tmuiImgQueue[i - 1]->args != nullptr)
+                break;
+            TmuiWebJob *swap = g_tmuiImgQueue[i - 1];
+            g_tmuiImgQueue.SetAtIndex(i - 1, g_tmuiImgQueue[i]);
+            g_tmuiImgQueue.SetAtIndex(i, swap);
+        }
+    }
+    g_tmuiWebLock.Unlock();
+    if (lane)
+        SetEvent(g_tmuiFileEvent);
+    else
+        ReleaseSemaphore(g_tmuiImgSem, 1, nullptr);
+    return S_OK;
+}
+
+// tmuiPrefetch?files=a|b|c: queue the ones not on disk yet, nobody waits
+void FlashProxyModule::TmuiImgPrefetch(const WCHAR *query)
+{
+    if (query == nullptr || _wcsnicmp(query, L"files=", 6) != 0 || !TmuiImgStart())
+        return;
+    CStringW list(query + 6);
+    list.Replace(L"%7C", L"|");
+    list.Replace(L"%7c", L"|");
+    int queued = 0;
+    int pos = 0;
+    CStringW name = list.Tokenize(L"|", pos);
+    while (!name.IsEmpty() && queued < 2000)
+    {
+        if (TmuiImgName(name))
+        {
+            TmuiWebJob *job = TmuiImgJob(name);
+            if (GetFileAttributes(job->file) != INVALID_FILE_ATTRIBUTES)
+            {
+                delete job;
+            }
+            else
+            {
+                g_tmuiWebLock.Lock();
+                g_tmuiImgQueue.Add(job);
+                g_tmuiWebLock.Unlock();
+                ReleaseSemaphore(g_tmuiImgSem, 1, nullptr);
+                ++queued;
+            }
+        }
+        name = list.Tokenize(L"|", pos);
+    }
+}
+
+void FlashProxyModule::TmuiWebDeliver()
+{
+    ATL::CSimpleArray<TmuiWebJob*> finished;
+    g_tmuiWebLock.Lock();
+    for (int i = g_tmuiWebJobs.GetSize() - 1; i >= 0; --i)
+    {
+        TmuiWebJob *job = g_tmuiWebJobs[i];
+        if (InterlockedCompareExchange(&job->done, 0, 0))
+        {
+            finished.Add(job);
+            g_tmuiWebJobs.RemoveAt(i);
+        }
+    }
+    g_tmuiWebLock.Unlock();
+
+    for (int i = 0; i < finished.GetSize(); ++i)
+    {
+        TmuiWebJob *job = finished[i];
+        CComPtr<IStream> stream;
+        if (job->ok)
+            stream.Attach(SHCreateMemStream(reinterpret_cast<const BYTE*>(job->data.GetString()), job->data.GetLength()));
+        CComPtr<ICoreWebView2WebResourceResponse> response;
+        if (job->env != nullptr)
+        {
+            CStringW headers(L"Content-Type: ");
+            headers += job->ctype.IsEmpty() ? L"text/xml" : job->ctype.GetString();
+            job->env->CreateWebResourceResponse(stream, job->ok ? 200 : 502, job->ok ? L"OK" : L"Bad Gateway",
+                                                headers, &response);
+        }
+        if (response != nullptr)
+            job->args->put_Response(response);
+        job->deferral->Complete();
+        delete job;
+    }
+}
+
+void FlashProxyModule::TmuiRelayDeliver()
+{
+    if (InterlockedExchange(&g_tmuiReaderGone, 0))
+    {
+        for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+            g_tmuiSubscribers[j]->TmuiPostVariable(L"tmui_chatreader", L"0");
+    }
+    if (InterlockedExchange(&g_tmuiReaderSeen, 0))
+    {
+        WCHAR seq[32];
+        _snwprintf_s(seq, _countof(seq), _TRUNCATE, L"1%%3A%ld", ++g_tmuiReaderSeq);
+        for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+            g_tmuiSubscribers[j]->TmuiPostVariable(L"tmui_chatreader", seq);
+    }
+    ATL::CSimpleArray<CStringW> items;
+    g_tmuiRelayLock.Lock();
+    for (int i = 0; i < g_tmuiRelayQueue.GetSize(); ++i)
+        items.Add(g_tmuiRelayQueue[i]);
+    g_tmuiRelayQueue.RemoveAll();
+    g_tmuiRelayLock.Unlock();
+    for (int i = 0; i < items.GetSize(); ++i)
+    {
+        for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+            g_tmuiSubscribers[j]->TmuiPostChat(items[i]);
+    }
+}
+
+HRESULT FlashProxyModule::TmuiPostChat(const WCHAR *value)
+{
+    if (!m_ready || m_view == nullptr)
+        return S_OK;
+    // percent-encode as UTF-8 ourselves: Encode() has a 10000 char buffer and a
+    // chat answer can be bigger than that once escaped
+    int blen = WideCharToMultiByte(CP_UTF8, 0, value, -1, nullptr, 0, nullptr, nullptr);
+    if (blen <= 0)
+        return E_FAIL;
+    CStringA utf8;
+    WideCharToMultiByte(CP_UTF8, 0, value, -1, utf8.GetBuffer(blen), blen, nullptr, nullptr);
+    utf8.ReleaseBuffer();
+    CStringW message(L"setVariable?name=tmui_chatfeed&value=");
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    for (int i = 0; i < utf8.GetLength(); ++i)
+    {
+        unsigned char c = static_cast<unsigned char>(utf8[i]);
+        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+            c == '-' || c == '_' || c == '.' || c == '~')
+        {
+            message += static_cast<WCHAR>(c);
+        }
+        else
+        {
+            message += L'%';
+            message += hex[c >> 4];
+            message += hex[c & 15];
+        }
+    }
+    return m_view->PostWebMessageAsString(message);
+}
+
+
+// put the timer on a proxy window, the game's message loop doesn't
+// dispatch thread timers reliably
+void FlashProxyModule::TmuiStartTimer()
+{
+    if (g_tmuiTimer != 0)
+        KillTimer(g_tmuiTimerWnd, g_tmuiTimer);
+    g_tmuiTimer = 0;
+    g_tmuiTimerWnd = nullptr;
+    for (int i = 0; i < g_tmuiSubscribers.GetSize(); ++i)
+    {
+        HWND wnd = g_tmuiSubscribers[i]->m_proxyWnd;
+        if (wnd != nullptr && IsWindow(wnd))
+        {
+            g_tmuiTimerWnd = wnd;
+            g_tmuiTimer = SetTimer(wnd, TMUI_TIMER_ID, 30, TmuiTimerProc);
+            return;
+        }
+    }
+    if (g_tmuiSubscribers.GetSize() > 0)
+    {
+        g_tmuiTimer = SetTimer(nullptr, 0, 30, TmuiTimerProc);
+    }
+}
+
+void CALLBACK FlashProxyModule::TmuiTimerProc(HWND, UINT, UINT_PTR, DWORD)
+{
+    DWORD pid = 0;
+    HWND fg = GetForegroundWindow();
+    if (fg != nullptr)
+        GetWindowThreadProcessId(fg, &pid);
+    bool active = pid == GetCurrentProcessId();
+    bool modifiers = GetAsyncKeyState(VK_MENU) < 0 || GetAsyncKeyState(VK_CONTROL) < 0 ||
+        GetAsyncKeyState(VK_SHIFT) < 0 || GetAsyncKeyState(VK_LWIN) < 0 || GetAsyncKeyState(VK_RWIN) < 0;
+
+    for (int i = 0; i < 12; ++i)
+    {
+        bool raw = GetAsyncKeyState(VK_F1 + i) < 0;
+        bool down = active && raw;
+        if (down && !g_tmuiDown[i] && !modifiers)
+        {
+            for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+                g_tmuiSubscribers[j]->TmuiPostHotkey(i + 1);
+        }
+        g_tmuiDown[i] = raw;
+    }
+
+    // right mouse button held in game = vehicle boost, the dock's boost gauge
+    // follows it. posted only on change
+    {
+        static LONG rmbLast = -1;
+        LONG rmb = (active && GetAsyncKeyState(VK_RBUTTON) < 0) ? 1 : 0;
+        if (rmb != rmbLast)
+        {
+            rmbLast = rmb;
+            for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+                g_tmuiSubscribers[j]->TmuiPostVariable(L"tmui_rmb", rmb ? L"1" : L"0");
+        }
+    }
+
+    // Delete in game = get out of the vehicle: tell the dock the moment it's
+    // pressed so the tacho's needle drops with the engine, not a seat check
+    // later. a counter, so every press is a change the page sees
+    {
+        static bool delLast = false;
+        static LONG delCount = 0;
+        bool del = active && !modifiers && GetAsyncKeyState(VK_DELETE) < 0;
+        if (del && !delLast)
+        {
+            WCHAR count[16];
+            _snwprintf_s(count, _countof(count), _TRUNCATE, L"%ld", ++delCount);
+            for (int j = 0; j < g_tmuiSubscribers.GetSize(); ++j)
+                g_tmuiSubscribers[j]->TmuiPostVariable(L"tmui_getout", count);
+        }
+        delLast = del;
+    }
+
+    TmuiKeymapTick(active);
+    TmuiRelayDeliver();
+    TmuiWebDeliver();
+}
