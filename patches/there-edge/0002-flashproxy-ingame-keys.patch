+// Put the real OS window where it belongs: normally the client's full rect, in
+// shape mode just the used part of it. The WebView's bounds get a negative
+// offset so the page doesn't notice the window moved underneath it.
+void FlashProxyModule::TmuiPlaceWindow()
+{
+    if (m_proxyWnd == nullptr)
+        return;
+
+    LONG pageW = max(1, m_size.cx);
+    LONG pageH = max(1, m_size.cy);
+    LONG x = m_pos.cx;
+    LONG y = m_pos.cy;
+    LONG w = pageW;
+    LONG h = pageH;
+
+    if (m_tmuiShapeOn)
+    {
+        RECT box = m_tmuiShapeBox;
+        box.left = max(0L, box.left);
+        box.top = max(0L, box.top);
+        box.right = min((LONG)pageW, box.right);
+        box.bottom = min((LONG)pageH, box.bottom);
+        if (box.right <= box.left || box.bottom <= box.top)
+        {
+            // nothing in use: keep a 1px sliver so the window still exists
+            box.left = 0;
+            box.top = 0;
+            box.right = 1;
+            box.bottom = 1;
+        }
+        x = m_pos.cx + box.left;
+        y = m_pos.cy + box.top;
+        w = box.right - box.left;
+        h = box.bottom - box.top;
+    }
+
+    SetWindowPos(m_proxyWnd, nullptr, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE);
+
+    if (m_controller != nullptr)
+    {
+        RECT bounds;
+        bounds.left = -(x - m_pos.cx);
+        bounds.top = -(y - m_pos.cy);
+        bounds.right = bounds.left + pageW;
+        bounds.bottom = bounds.top + pageH;
+        m_controller->put_Bounds(bounds);
+        m_controller->NotifyParentWindowPositionChanged();
+    }
+}
